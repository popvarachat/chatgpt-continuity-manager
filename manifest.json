{
  "manifest_version": 3,
  "name": "ChatGPT Continuity Manager",
  "version": "1.9.0",
  "description": "Local continuity and Chat Steward tools for ChatGPT: recovery, handoff, lifecycle review, human-gated organization, and v1.8.9 smart handoff improvements.",
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "continuity-storage-bridge.js",
        "chat-steward-engine.js",
        "chat-steward-collector.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-conversation-handoff-exporter.user.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://popvarachat.github.io/chat-steward/*"
      ],
      "js": [
        "chat-steward-engine.js",
        "chat-steward-dashboard-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
